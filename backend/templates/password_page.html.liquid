<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ title | default: 'Protected Site' }}</title>
<style>
  body { font-family: system-ui, -apple-system, sans-serif; background: #1a1d23; color: #e5e7eb;
         margin: 0; display: grid; place-items: center; min-height: 100vh; }
  .card { background: #2d3139; padding: 2rem; border-radius: 12px;
          max-width: 380px; width: 100%; box-shadow: 0 8px 24px rgba(0,0,0,.4); }
  h2 { margin-top: 0; }
  label { display: block; margin: .8rem 0 .3rem; font-size: .9rem; color: #9ca3af; }
  input { width: 100%; padding: .7rem; border-radius: 6px; border: 1px solid #4b5563;
          background: #1a1d23; color: #e5e7eb; box-sizing: border-box; font-size: 1rem; }
  button { width: 100%; margin-top: 1rem; padding: .8rem; border-radius: 6px;
           background: #84cc16; color: #1a1d23; border: none;
           font-weight: 600; font-size: 1rem; cursor: pointer; }
  button:hover { background: #a3e635; }
  .err { color: #fca5a5; min-height: 1.2em; margin-top: .5rem; font-size: .9rem; }
</style>
</head>
<body>
<div class="card">
  <h2>{{ title | default: 'Protected Site' }}</h2>
  <p style="color:#9ca3af">Enter the password to access this site.</p>
  <form id="f">
    <label>Username <input id="u" value="admin" autocomplete="username"></label>
    <label>Password <input id="p" type="password" autofocus autocomplete="current-password"></label>
    <div class="err" id="err"></div>
    <button type="submit">Continue</button>
  </form>
</div>
<script>
  const HOST_ID = {{ id }};
  const ORIG_PATH = {{ orig_path | default: '/' | json }};
  const ORIG_QUERY = {{ orig_query | default: '' | json }};
  const ORIGIN = window.location.origin;
  const TARGET = ORIGIN + ORIG_PATH + (ORIG_QUERY ? "?" + ORIG_QUERY : "");
  const KEY = "ph_auth_" + HOST_ID;
  const buildAuth = (u, p) => "Basic " + btoa(u + ":" + p);

  async function tryWith(u, p) {
    try {
      const res = await fetch(TARGET, {
        headers: { Authorization: buildAuth(u, p) },
        redirect: "manual",
        credentials: "include"
      });
      return res.status === 200 || res.status === 304 || res.type === "opaqueredirect";
    } catch (_) { return false; }
  }

  // Try cached credential on load (sessionStorage only - cleared when tab closes)
  (async () => {
    const saved = sessionStorage.getItem(KEY);
    if (!saved) return;
    let u, p;
    try { [u, p] = atob(saved).split(":"); } catch (_) { return; }
    if (!u || !p) return;
    if (await tryWith(u, p)) window.location.replace(TARGET);
  })();

  document.getElementById("f").addEventListener("submit", async (e) => {
    e.preventDefault();
    const u = document.getElementById("u").value.trim();
    const p = document.getElementById("p").value;
    document.getElementById("err").textContent = "";
    if (!u || !p) {
      document.getElementById("err").textContent = "Username and password required.";
      return;
    }
    if (await tryWith(u, p)) {
      sessionStorage.setItem(KEY, btoa(u + ":" + p));
      window.location.replace(TARGET);
    } else {
      document.getElementById("err").textContent = "Invalid password.";
    }
  });
</script>
</body>
</html>