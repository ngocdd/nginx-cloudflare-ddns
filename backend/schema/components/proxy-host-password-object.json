{
	"type": "object",
	"description": "Per-domain password protection entry",
	"required": ["id", "domain", "username", "enabled"],
	"properties": {
		"id": {
			"$ref": "../common.json#/properties/id"
		},
		"domain": {
			"type": "string",
			"minLength": 1,
			"maxLength": 255,
			"description": "Domain name (must be present in the parent proxy_host.domain_names)"
		},
		"username": {
			"type": "string",
			"minLength": 1,
			"maxLength": 255,
			"example": "admin"
		},
		"enabled": {
			"type": "boolean",
			"description": "Whether this password entry is active"
		},
		"hint": {
			"type": "string",
			"description": "Masked password indicator (e.g. 'a****')"
		},
		"password": {
			"type": "string",
			"description": "Plaintext password - ONLY used on create/update. Never returned by GET.",
			"minLength": 1,
			"maxLength": 1024
		},
		"meta": {
			"type": "object"
		}
	}
}