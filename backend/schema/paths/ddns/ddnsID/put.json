{
	"operationId": "updateDdnsConfig",
	"summary": "Update a DDNS Configuration",
	"tags": ["ddns"],
	"security": [
		{
			"bearerAuth": ["admin"]
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "ddnsID",
			"required": true,
			"schema": {
				"type": "integer",
				"minimum": 1
			}
		}
	],
	"requestBody": {
		"description": "DDNS Configuration Payload",
		"required": true,
		"content": {
			"application/json": {
				"schema": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"name": {
							"$ref": "../../../components/ddns-config-object.json#/properties/name"
						},
						"provider": {
							"$ref": "../../../components/ddns-config-object.json#/properties/provider"
						},
						"domain": {
							"$ref": "../../../components/ddns-config-object.json#/properties/domain"
						},
						"ip_version": {
							"$ref": "../../../components/ddns-config-object.json#/properties/ip_version"
						},
						"update_cron": {
							"$ref": "../../../components/ddns-config-object.json#/properties/update_cron"
						},
						"enabled": {
							"$ref": "../../../components/ddns-config-object.json#/properties/enabled"
						},
						"config_json": {
							"$ref": "../../../components/ddns-config-object.json#/properties/config_json"
						},
						"meta": {
							"$ref": "../../../components/ddns-config-object.json#/properties/meta"
						}
					}
				}
			}
		}
	},
	"responses": {
		"200": {
			"description": "200 response",
			"content": {
				"application/json": {
					"schema": {
						"$ref": "../../../components/ddns-config-object.json"
					}
				}
			}
		}
	}
}