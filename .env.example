# docker compose environment overrides for nginx-ddns.
# Copy this file to `.env` next to `docker-compose.yml` and tweak as needed.
# Any value left blank or commented out falls back to the default baked into
# docker-compose.yml.

# --- Image --------------------------------------------------------------------
# Pin a specific tag (e.g. v2.14.0) instead of floating on `latest`.
# IMAGE_TAG=latest

# --- Host port mappings -------------------------------------------------------
# Change these if 80/81/443 are already taken on the host.
# HTTP_PORT=80
# ADMIN_PORT=81
# HTTPS_PORT=443

# --- Application behaviour ----------------------------------------------------
# Set to `true` to disable IPv6 support in Nginx Proxy Manager.
# DISABLE_IPV6=false
# X_FRAME_OPTIONS=deny

# --- Cloudflare DDNS ----------------------------------------------------------
# Optional: pre-bake a default API token via env_file. Tokens are NOT committed
# to git — keep them in your local .env file only.
# CLOUDFLARE_API_TOKEN=your-token-with- Zone:DNS:Edit